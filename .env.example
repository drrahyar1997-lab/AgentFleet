# Copy to .env. Never commit .env or share these secrets.
# Generate a strong token with: openssl rand -hex 32
API_ACCESS_TOKEN=

# Used only by Docker Compose. Use a random URL-safe password, e.g. openssl rand -hex 24.
POSTGRES_PASSWORD=

# For direct local backend development, configure a local PostgreSQL URL.
# Docker Compose constructs its own database URL from POSTGRES_PASSWORD.
DATABASE_URL_SYNC=postgresql://ecom_dev:CHANGE_ME@localhost:5432/ecom_ai_lab

# LLM provider keys (at least one is needed for real model calls)
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
